---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Laura Reynolds Nutrition',
  description = 'No nonsense nutrition coaching',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="logo-link">
          <img src="/logo.svg" alt="Laura Reynolds Nutrition" class="logo-img" />
          <span class="logo-text">LR Nutrition</span>
        </a>
        <button class="btn-header-cta" id="header-get-started">Get Started</button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <p class="footer-name">Laura Reynolds<br />Nutrition</p>
            <p class="footer-tagline">No nonsense nutrition coaching for real life.</p>
          </div>

          <div class="footer-col">
            <h4>Quick links</h4>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/about">About Laura</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/enquire">Enquire</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Get in touch</h4>
            <p><a href="mailto:hello@lrnutrition.co.uk">hello@lrnutrition.co.uk</a></p>
          </div>

          <div class="footer-col">
            <h4>Follow along</h4>
            <div class="social-icons">
              <a href="#" aria-label="Instagram" class="social-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
                </svg>
                Instagram
              </a>
              <a href="#" aria-label="Facebook" class="social-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.88v2.27h3.32l-.53 3.5h-2.79V24C19.62 23.1 24 18.1 24 12.07z"/>
                </svg>
                Facebook
              </a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Laura Reynolds Nutrition. All rights reserved.</p>
          <div class="footer-legal">
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  // Prevent body scroll when modal is open
  const modal = document.getElementById('enquiry-modal') as HTMLDialogElement;

  if (modal) {
    modal.addEventListener('open', () => {
      document.documentElement.style.overflow = 'hidden';
    });

    modal.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });

    // Also listen for showModal() and close()
    const originalShowModal = modal.showModal.bind(modal);
    modal.showModal = function() {
      document.documentElement.style.overflow = 'hidden';
      return originalShowModal();
    };

    const originalClose = modal.close.bind(modal);
    modal.close = function() {
      document.documentElement.style.overflow = '';
      return originalClose();
    };
  }

  // Link header button to modal
  const headerBtn = document.getElementById('header-get-started');
  headerBtn?.addEventListener('click', () => {
    modal?.showModal();
  });
</script>

<style>
  :root {
    --coral: #D17A6A;
    --blush: #F0C0B0;
    --brown: #7A4020;
    --cream: #FDF8F5;
    --text: #2d1a0e;
    --text-muted: #7a6a62;
    --font: Georgia, 'Times New Roman', serif;
    --font-sans: system-ui, -apple-system, sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-sans);
    font-size: 16px;
    background-color: var(--coral);
    color: var(--text);
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  /* ── Header ── */
  header {
    background-color: var(--cream);
    border-bottom: 1px solid rgba(122, 64, 32, 0.12);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex: 1;
  }

  .logo-img {
    width: 40px;
    height: 40px;
    display: block;
  }

  .logo-text {
    font-family: var(--font);
    font-size: 1rem;
    font-weight: bold;
    color: var(--brown);
  }

  .btn-header-cta {
    background-color: var(--coral);
    color: var(--cream);
    padding: 0.65rem 1.25rem;
    border: none;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }

  .btn-header-cta:hover {
    opacity: 0.85;
  }

  @media (max-width: 480px) {
    .btn-header-cta {
      padding: 0.55rem 1rem;
      font-size: 0.85rem;
    }

    .logo-text {
      display: none;
    }

    .logo-img {
      width: 36px;
      height: 36px;
    }
  }

  /* ── Main ── */
  main {
    flex: 1;
  }

  /* ── Footer ── */
  footer {
    background-color: var(--brown);
    color: var(--blush);
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.25rem 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(240, 192, 176, 0.2);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }

  .footer-name {
    font-family: var(--font);
    font-size: 1.1rem;
    font-weight: bold;
    color: var(--cream);
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .footer-tagline {
    font-size: 0.85rem;
    opacity: 0.7;
    line-height: 1.55;
  }

  .footer-col h4 {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--cream);
    opacity: 0.6;
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col a {
    color: var(--blush);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s;
  }

  .footer-col a:hover {
    color: var(--cream);
  }

  .footer-col p {
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .social-icons {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--blush);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s;
  }

  .social-link:hover {
    color: var(--cream);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    font-size: 0.78rem;
    opacity: 0.6;
  }

  .footer-legal {
    display: flex;
    gap: 1.25rem;
  }

  .footer-legal a {
    color: inherit;
    text-decoration: none;
  }

  .footer-legal a:hover {
    text-decoration: underline;
  }
</style>
