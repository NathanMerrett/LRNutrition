---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Laura Reynolds Nutrition',
  description = 'No nonsense nutrition coaching',
} = Astro.props;

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/blog', label: 'Balanced Bite Blog' },
];

// Trailing slashes vary between dev and the built output, so normalise before
// comparing — otherwise /blog never matches /blog/ and nothing is ever current.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload the two self-hosted variable fonts. They are discovered late
         (inside a CSS file), so without this they start downloading only after
         the stylesheet parses, and text flashes in the fallback. -->
    <link
      rel="preload"
      href="/fonts/fraunces-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header>
      <div class="header-inner">
        <a href="/" class="logo-link">
          <img src="/logo.webp" alt="Laura Reynolds Nutrition" class="logo-img" width="40" height="40" />
          <span class="logo-text">LR Nutrition</span>
        </a>

        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              navLinks.map(({ href, label }) => (
                <li>
                  <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <a href="/enquire" class="btn btn-primary btn-header">Get started</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <p class="footer-name">Laura Reynolds<br />Nutrition</p>
            <p class="footer-tagline">No nonsense nutrition coaching for real life.</p>
          </div>

          <!-- A labelled nav: on phones the header links are hidden, so this is
               the site navigation landmark there. -->
          <nav class="footer-col" aria-labelledby="footer-nav-heading">
            <h2 id="footer-nav-heading">Quick links</h2>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/about">About Laura</a></li>
              <li><a href="/services">Services</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/enquire">Enquire</a></li>
            </ul>
          </nav>

          <div class="footer-col">
            <h2>Get in touch</h2>
            <p><a href="mailto:hello@lrnutrition.co.uk">hello@lrnutrition.co.uk</a></p>
          </div>

          <div class="footer-col">
            <h2>Follow along</h2>
            <div class="social-icons">
              <a href="#" aria-label="Instagram" class="social-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
                </svg>
                Instagram
              </a>
              <a href="#" aria-label="Facebook" class="social-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.88v2.27h3.32l-.53 3.5h-2.79V24C19.62 23.1 24 18.1 24 12.07z"/>
                </svg>
                Facebook
              </a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Laura Reynolds Nutrition. All rights reserved.</p>
          <div class="footer-legal">
            <a href="/privacy">Privacy policy</a>
            <a href="/terms">Terms of service</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ── Skip link ── */
  .skip-link {
    position: absolute;
    left: var(--space-md);
    top: -100px;
    z-index: 100;
    background-color: var(--color-text);
    color: var(--color-text-inverse);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: var(--weight-semibold);
    transition: top var(--dur-fast) var(--ease-out);
  }

  .skip-link:focus-visible {
    top: var(--space-md);
  }

  /* ── Header ── */
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    border-bottom: 1px solid var(--color-border);
    /* Frosted glass, where supported. The mostly-opaque background above is
       the fallback, so text stays legible without it. */
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    /* Keep the header out of the view transition's cross-fade so it appears
       to stay put between pages rather than blinking. */
    view-transition-name: site-header;
  }

  .header-inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: var(--space-xs) var(--gutter);
    /* Respect the notch in landscape on iOS */
    padding-left: max(var(--gutter), env(safe-area-inset-left));
    padding-right: max(var(--gutter), env(safe-area-inset-right));
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: var(--tap-target);
    text-decoration: none;
    margin-right: auto;
  }

  .logo-img {
    width: 40px;
    height: 40px;
    display: block;
  }

  /* The wordmark is the brand, so it keeps the heading face. */
  .logo-text {
    font-family: var(--font-heading);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-h3);
    color: var(--color-text);
  }

  /* ── Nav ──
   * Phones get just the logo and "Get started"; the page links live in the
   * homepage sections and the footer. From 640px there is room to show them.
   */
  .site-nav {
    display: none;
  }

  @media (min-width: 640px) {
    .site-nav {
      display: block;
    }
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(var(--space-sm), 3vw, var(--space-xl));
  }

  .site-nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
  }

  /* Underline that grows out from the centre, rather than a hard border. */
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-xs);
    height: 2px;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary);
    transform: scaleX(0);
    transition: transform var(--dur-mid) var(--ease-out);
  }

  @media (hover: hover) {
    .site-nav a:hover {
      color: var(--color-text);
    }

    .site-nav a:hover::after {
      transform: scaleX(1);
    }
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .btn-header {
    padding-inline: var(--space-md);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .logo-text {
      display: none;
    }

    .logo-img {
      width: 34px;
      height: 34px;
    }
  }

  /* ── Main ── */
  main {
    flex: 1;
  }

  /* ── Footer ──
   * A dark band: --color-text as the background, inverse text on top (13.8:1).
   * Hierarchy comes from size and weight, never from opacity.
   */
  footer {
    background-color: var(--color-text);
    color: var(--color-text-inverse);
    /* Fill the home-indicator area on iOS instead of leaving a pale strip. */
    padding-bottom: env(safe-area-inset-bottom);
  }

  .footer-inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: var(--space-3xl) var(--gutter) var(--space-lg);
    padding-left: max(var(--gutter), env(safe-area-inset-left));
    padding-right: max(var(--gutter), env(safe-area-inset-right));
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }

  .footer-name {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
    margin-bottom: var(--space-xs);
  }

  .footer-tagline {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  /* Column labels are real headings (for screen-reader navigation), styled as
     small labels rather than display type. */
  .footer-col h2 {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-xs);
  }

  .footer-col ul {
    list-style: none;
  }

  .social-icons {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Links keep a 44px tap target; the padding grows, not the text. */
  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap-target);
    color: var(--color-text-inverse);
    text-decoration: none;
  }

  .footer-legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--color-text-inverse);
  }

  @media (hover: hover) {
    .footer-col a:hover {
      color: var(--color-accent);
      text-decoration: underline;
    }

    .footer-legal a:hover {
      color: var(--color-accent);
    }
  }

  footer :focus-visible {
    outline-color: var(--color-text-inverse);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-lg);
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-sm);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  .footer-legal {
    display: flex;
    gap: var(--space-lg);
  }
</style>
