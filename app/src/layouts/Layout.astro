---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Laura Reynolds Nutrition',
  description = 'No nonsense nutrition coaching',
} = Astro.props;

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
];

// Trailing slashes vary between dev and the built output, so normalise before
// comparing — otherwise /blog never matches /blog/ and nothing is ever current.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload the two variable fonts. They are same-origin and discovered
         late (inside a CSS file), so without this they start downloading only
         after the stylesheet parses, and headings flash in the fallback. -->
    <link
      rel="preload"
      href="/fonts/fraunces-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header>
      <div class="header-inner">
        <a href="/" class="logo-link">
          <img src="/logo.svg" alt="Laura Reynolds Nutrition" class="logo-img" width="40" height="40" />
          <span class="logo-text">LR Nutrition</span>
        </a>

        <nav aria-label="Main">
          <ul>
            {
              navLinks.map(({ href, label }) => (
                <li>
                  <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <a href="/enquire" class="btn btn-primary btn-header">Get Started</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <p class="footer-name">Laura Reynolds<br />Nutrition</p>
            <p class="footer-tagline">No nonsense nutrition coaching for real life.</p>
          </div>

          <div class="footer-col">
            <h4>Quick links</h4>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/about">About Laura</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/enquire">Enquire</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Get in touch</h4>
            <p><a href="mailto:hello@lrnutrition.co.uk">hello@lrnutrition.co.uk</a></p>
          </div>

          <div class="footer-col">
            <h4>Follow along</h4>
            <div class="social-icons">
              <a href="#" aria-label="Instagram" class="social-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
                </svg>
                Instagram
              </a>
              <a href="#" aria-label="Facebook" class="social-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.88v2.27h3.32l-.53 3.5h-2.79V24C19.62 23.1 24 18.1 24 12.07z"/>
                </svg>
                Facebook
              </a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Laura Reynolds Nutrition. All rights reserved.</p>
          <div class="footer-legal">
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ── Skip link ── */
  .skip-link {
    position: absolute;
    left: var(--space-md);
    top: -100px;
    z-index: 100;
    background-color: var(--brown);
    color: var(--cream);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    transition: top var(--dur-fast) var(--ease-out);
  }

  .skip-link:focus-visible {
    top: var(--space-md);
  }

  /* ── Header ── */
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: rgba(253, 248, 245, 0.82);
    border-bottom: 1px solid var(--brown-08);
    /* Frosted glass, where supported. The solid-ish background above is the
       fallback, so text stays legible without it. */
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    /* Keep the header out of the view transition's cross-fade so it appears
       to stay put between pages rather than blinking. */
    view-transition-name: site-header;
  }

  .header-inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: var(--space-sm) var(--gutter);
    /* Respect the notch in landscape on iOS */
    padding-left: max(var(--gutter), env(safe-area-inset-left));
    padding-right: max(var(--gutter), env(safe-area-inset-right));
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    margin-right: auto;
  }

  .logo-img {
    width: 40px;
    height: 40px;
    display: block;
  }

  .logo-text {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--brown);
    letter-spacing: -0.01em;
  }

  /* ── Nav ── */
  nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 1.75rem);
  }

  nav a {
    position: relative;
    display: block;
    padding: var(--space-xs) 0;
    color: var(--brown);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    opacity: 0.75;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  /* Underline that grows out from the centre, rather than a hard border. */
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: var(--radius-pill);
    background-color: var(--coral-text);
    transform: scaleX(0);
    transition: transform var(--dur-mid) var(--ease-out);
  }

  @media (hover: hover) {
    nav a:hover {
      opacity: 1;
    }

    nav a:hover::after {
      transform: scaleX(1);
    }
  }

  nav a[aria-current='page'] {
    opacity: 1;
    font-weight: 600;
  }

  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .btn-header {
    padding: 0.6rem 1.15rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .logo-text {
      display: none;
    }

    .logo-img {
      width: 34px;
      height: 34px;
    }

    nav a {
      font-size: 0.9rem;
    }

    .btn-header {
      padding: 0.55rem 0.95rem;
      font-size: 0.85rem;
    }
  }

  /* ── Main ── */
  main {
    flex: 1;
  }

  /* ── Footer ── */
  footer {
    background-color: var(--brown);
    color: var(--blush);
    /* Fill the home-indicator area on iOS instead of leaving a pale strip. */
    padding-bottom: env(safe-area-inset-bottom);
  }

  .footer-inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: var(--space-3xl) var(--gutter) var(--space-lg);
    padding-left: max(var(--gutter), env(safe-area-inset-left));
    padding-right: max(var(--gutter), env(safe-area-inset-right));
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--blush-20);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }

  .footer-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--cream);
    margin-bottom: 0.6rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .footer-tagline {
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .footer-col h4 {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--cream);
    opacity: 0.8;
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer-col a {
    color: var(--blush);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--cream);
  }

  .footer-col p {
    font-size: 0.9rem;
  }

  .social-icons {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--blush);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .social-link:hover {
    color: var(--cream);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-md);
    font-size: 0.78rem;
    opacity: 0.85;
  }

  .footer-legal {
    display: flex;
    gap: var(--space-lg);
  }

  .footer-legal a {
    color: inherit;
    text-decoration: none;
  }

  .footer-legal a:hover {
    text-decoration: underline;
  }
</style>
