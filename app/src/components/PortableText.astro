---
/**
 * Renders a Sanity Portable Text body.
 *
 * Normally `astro-portabletext` would do this, but that dependency was declined,
 * so this walks the block array itself. It covers what the post schema allows:
 * `block` (styles, decorators, link annotations, lists) and `image`.
 *
 * The fiddly part is lists. Portable Text has no <ul>/<ol> — it emits a flat run
 * of blocks carrying `listItem` and `level`, so consecutive items have to be
 * collected back into real list elements. Rendering each item as its own <ul> is
 * the classic bug here.
 */
import PortableTextBlockView from './PortableTextBlock.astro';
import PortableTextList from './PortableTextList.astro';
import type { ListNode } from './PortableTextList.astro';
import type { PortableTextBlock } from '../data/posts';

interface Props {
  value?: PortableTextBlock[];
}

const { value = [] } = Astro.props;

type Segment =
  | { kind: 'lists'; blocks: PortableTextBlock[] }
  | { kind: 'block'; block: PortableTextBlock };

/** Collect runs of list blocks so they can become single list elements. */
function segment(blocks: PortableTextBlock[]): Segment[] {
  const segments: Segment[] = [];

  for (const block of blocks) {
    if (block._type === 'block' && block.listItem) {
      const last = segments.at(-1);
      if (last?.kind === 'lists') {
        last.blocks.push(block);
      } else {
        segments.push({ kind: 'lists', blocks: [block] });
      }
    } else {
      segments.push({ kind: 'block', block });
    }
  }

  return segments;
}

/** Turn a flat run of list blocks into a tree, using each block's `level`. */
function buildLists(blocks: PortableTextBlock[]): ListNode[] {
  const roots: ListNode[] = [];
  const stack: ListNode[] = []; // stack[n] is the open list at depth n + 1

  for (const block of blocks) {
    const level = Math.max(1, block.level ?? 1);
    const listItem = block.listItem ?? 'bullet';

    // Close any lists deeper than this item.
    stack.length = Math.min(stack.length, level);

    let current = stack[level - 1];

    // Open a new list when there isn't one at this depth, or when the list type
    // changes (a bulleted run followed by a numbered run is two lists).
    if (!current || current.listItem !== listItem) {
      const node: ListNode = { listItem, items: [] };
      const parentItem = stack[level - 2]?.items.at(-1);

      if (level === 1 || !parentItem) {
        // Level 1, or malformed input that skips a level — keep the content
        // rather than dropping it on the floor.
        roots.push(node);
      } else {
        parentItem.children.push(node);
      }

      stack[level - 1] = node;
      stack.length = level;
      current = node;
    }

    current.items.push({ block, children: [] });
  }

  return roots;
}

const segments = segment(value);
---

<!-- Typography comes from the shared .prose styles in components.css, which
     also cover the legal pages. -->
<div class="portable-text prose">
  {
    segments.map((seg) =>
      seg.kind === 'lists' ? (
        buildLists(seg.blocks).map((node) => <PortableTextList node={node} />)
      ) : (
        <PortableTextBlockView block={seg.block} />
      ),
    )
  }
</div>
