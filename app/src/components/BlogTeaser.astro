---
import PostCard from './PostCard.astro';
import type { PostSummary } from '../data/posts';

interface Props {
  posts: PostSummary[];
}

const { posts } = Astro.props;
---

<!-- The caller decides whether there is anything to show; this renders nothing
     rather than an empty section heading. -->
{
  posts.length > 0 && (
    <section class="blog-section section">
      <div class="container">
        <header class="section-head reveal">
          <div>
            {/* <p class="eyebrow">From the blog</p> */}
            <h2>From the blog</h2>
          </div>
          <a href="/blog" class="see-all">
            See all posts <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </header>

        <div class="blog-cards">
          {posts.map((post, i) => (
            <PostCard post={post} index={i} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .blog-section {
    border-top: 1px solid var(--color-border);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap-target);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .see-all .arrow {
    transition: transform var(--dur-mid) var(--ease-out);
  }

  @media (hover: hover) {
    .see-all:hover {
      text-decoration: underline;
    }

    .see-all:hover .arrow {
      transform: translateX(5px);
    }
  }

  .blog-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 620px) {
    .blog-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .blog-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
