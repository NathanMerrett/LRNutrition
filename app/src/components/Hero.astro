---
// The homepage hero: a full-bleed coral band, with the pitch on the left and
// a photo of Laura on the right. On a phone they stack, text first, so the
// headline and buttons are what shows above the fold.
---

<section class="hero band">
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="eyebrow enter" style="--i: 0">Registered Associate Nutritionist</p>
      <h1 class="enter" style="--i: 1">No nonsense nutrition coaching</h1>
      <p class="hero-lede enter" style="--i: 2">
        Helping you improve your energy, quality of life and long-term health with
        tailored coaching, meal plans and practical, achievable goals.
      </p>
      <div class="hero-actions enter" style="--i: 3">
        <a href="/enquire" class="btn btn-primary">
          Get started <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/about" class="btn btn-secondary">Meet Laura</a>
      </div>
    </div>

    <div class="hero-media enter" style="--i: 4">
      <!-- Placeholder until the photo is ready. Replace this div with
           <img src="/laura.jpg" alt="Laura Reynolds" width="800" height="1000" />
           (any portrait works; it is cropped to fit, keeping the top in view). -->
      <div class="photo-placeholder">Photo of Laura coming soon</div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--section-y);
  }

  /* One column on a phone; text and photo side by side once there is room. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 760px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }

  .hero h1 {
    margin-bottom: var(--space-lg);
  }

  .hero-lede {
    max-width: 44ch;
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* On a narrow phone the main action is full width, with the quieter one
     stacked beneath it, rather than cramming them side by side. */
  @media (max-width: 400px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Square on a phone so it doesn't make the band very tall; portrait once it
     sits beside the text. The real photo should fill the same box. */
  .hero-media img {
    display: block;
  }

  .hero-media :is(img, .photo-placeholder) {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-2xl);
    object-fit: cover;
    object-position: top;
  }

  @media (min-width: 760px) {
    .hero-media :is(img, .photo-placeholder) {
      aspect-ratio: 4 / 5;
    }
  }

  /* Cream on the coral band, with muted text (5.6:1 on cream). */
  .photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
</style>
