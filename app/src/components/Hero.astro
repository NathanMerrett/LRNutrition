---
// The homepage hero: the one full-bleed coral band on the site.
---

<section class="hero">
  <!-- Decorative blurred colour blobs. aria-hidden and pointer-events: none —
       they are texture, not content. -->
  <div class="hero-blobs" aria-hidden="true">
    <span class="blob blob-a"></span>
    <span class="blob blob-b"></span>
  </div>

  <div class="hero-content container container-narrow">
    <p class="eyebrow enter" style="--i: 0">Registered nutritionist</p>
    <h1 class="enter" style="--i: 1">No nonsense nutrition coaching.</h1>
    <p class="hero-lede enter" style="--i: 2">
      Practical, personalised guidance to help you build a healthier relationship
      with food — without the fads.
    </p>
    <div class="hero-actions enter" style="--i: 3">
      <a href="/enquire" class="btn btn-dark">
        Get Started <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a href="/about" class="btn btn-ghost">Meet Laura</a>
    </div>
  </div>

  <!-- Curved join into the cream section below, instead of a hard edge. -->
  <div class="hero-curve" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--gradient-warm);
    padding-block: clamp(4rem, 12vw, 8rem) clamp(5rem, 12vw, 9rem);
    text-align: center;
    overflow: hidden;
  }

  /* ── Decorative blobs ── */
  .hero-blobs {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    /* Kept low deliberately: these sit behind cream text, and a lighter blob
       raises the local background luminance enough to drop the small text
       under 4.5:1 against the band. */
    opacity: 0.2;
  }

  .blob-a {
    width: 30rem;
    height: 30rem;
    top: -12rem;
    left: -10rem;
    background-color: var(--blush);
  }

  /* Brown, not blush — it darkens the band, so it can only help contrast. */
  .blob-b {
    width: 26rem;
    height: 26rem;
    bottom: -14rem;
    right: -8rem;
    background-color: var(--brown);
    opacity: 0.28;
  }

  /* A slow drift keeps the band from feeling static. Very low amplitude — it
     should be barely perceptible, not a distraction behind the text. */
  @media (prefers-reduced-motion: no-preference) {
    .blob-a {
      animation: drift 22s var(--ease-out) infinite alternate;
    }

    .blob-b {
      animation: drift 28s var(--ease-out) infinite alternate-reverse;
    }
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(2.5rem, 1.5rem, 0) scale(1.12);
    }
  }

  /* ── Content ── */
  .hero-content {
    position: relative;
  }

  .eyebrow {
    color: var(--cream);
  }

  .hero h1 {
    font-size: var(--text-hero);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--cream);
    margin-bottom: var(--space-lg);
  }

  .hero-lede {
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    line-height: 1.65;
    color: var(--cream);
    max-width: 44ch;
    margin: 0 auto var(--space-xl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }

  /* Secondary action: outlined, so it reads as the quieter of the two. */
  .btn-ghost {
    background-color: transparent;
    color: var(--cream);
    box-shadow: inset 0 0 0 1.5px var(--cream-28);
  }

  @media (hover: hover) {
    .btn-ghost:hover {
      background-color: var(--cream-12);
      box-shadow: inset 0 0 0 1.5px var(--cream);
      transform: translateY(-2px);
    }
  }

  .hero :global(.btn:focus-visible) {
    outline-color: var(--cream);
    outline-offset: 3px;
  }

  /* On a narrow phone, stack the buttons full width rather than cramming
     them side by side. */
  @media (max-width: 400px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* ── Curved join ── */
  .hero-curve {
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: -3.5rem;
    height: 7rem;
    background-color: var(--cream);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }
</style>
