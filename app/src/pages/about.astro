---
import Layout from '../layouts/Layout.astro';

const credentials = [
  'MSc Nutrition — London Metropolitan',
  'AfN Registration Number - 40207',
];
---

<Layout title="About | Laura Reynolds Nutrition" description="About Laura Reynolds, Registered Associate Nutritionist.">
  <!-- <section class="page-hero">
    <div class="container">
      <h1>About Me</h1>
      <p class="lede">Registered Associate Nutritionist. Real food. No nonsense.</p>
    </div>
  </section>  -->

  <section class="bio section">
    <div class="container bio-grid">
      <div class="bio-media reveal">
        <!-- Replace with <img src="/laura.jpg" alt="Laura Reynolds" /> when ready -->
        <div class="image-box">Photo coming soon</div>
      </div>

      <div class="bio-text reveal" style="--i: 1">
        <p class="eyebrow">Hi, I'm Laura</p>
        <h2>Food advice that fits your actual life</h2>
        <p>
          After a career change in 2023, I followed my love of food and health and completed a Master’s degree in Human Nutrition. I am now a Registered Associate Nutritionist with the AfN, supporting individuals to make meaningful, lasting changes to their health.
        </p>
        <p>
          I’m also driven by my own experiences, as I was diagnosed with coeliac disease in my mid-twenties after a routine blood test. I can completely relate to feeling that total lack of energy, and the overwhelm of complete overhauls of diet and lifestyle (whether out of choice or not!).
        </p>
        <p>
          My approach is driven by science as a whole, not single studies or trends. I look at the full body of research and use the strongest types of evidence available to guide my recommendations. Whether your goal is improving energy levels, enhancing sports performance, or managing weight in a sustainable way, my approach will always be evidence based. It will be practical, supportive, and tailored to you, focusing on simple steps that fit into your everyday life.
        </p>
      </div>
    </div>
  </section>

  <section class="credentials section">
    <div class="container">
      <header class="section-head reveal">
        <p class="eyebrow">Credentials</p>
        <h2>Qualifications &amp; training</h2>
      </header>
      <ul class="cred-list">
        {
          credentials.map((item, i) => (
            <li class="card reveal" style={`--i: ${i}`}>
              <span class="tick" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band-soft cta-band">
    <div class="container container-narrow reveal">
      <h2>Ready to get started?</h2>
      <p>Get in touch and we can talk about what you're looking for.</p>
      <a href="/enquire" class="btn btn-primary">
        Enquire now <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* ── Bio ── */
  .bio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 760px) {
    .bio-grid {
      grid-template-columns: minmax(240px, 340px) 1fr;
    }
  }

  .image-box {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .bio-text h2 {
    margin-bottom: var(--space-md);
  }

  .bio-text p:not(.eyebrow) {
    margin-bottom: var(--space-md);
  }

  .bio-text p:last-child {
    margin-bottom: 0;
  }

  /* ── Credentials ── */
  .credentials {
    border-top: 1px solid var(--color-border);
  }

  .section-head {
    margin-bottom: var(--space-xl);
  }

  .cred-list {
    list-style: none;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--container-prose);
  }

  .cred-list li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: none;
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    transition:
      transform var(--dur-mid) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out);
  }

  @media (hover: hover) {
    .cred-list li:hover {
      transform: translateX(4px);
      box-shadow: var(--shadow-md);
    }
  }

  /* Espresso on the blush accent is 11:1. */
  .tick {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-primary);
  }

  .tick svg {
    width: 14px;
    height: 14px;
  }
</style>
