---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../data/posts';

const posts = await getPosts();
---

<Layout title="Blog | Laura Reynolds Nutrition" description="Practical nutrition tips and honest advice.">
  <section class="page-hero">
    <div class="container">
      <h1>The blog</h1>
      <p class="lede">
        Practical tips and honest takes on food, nutrition, and everyday eating.
      </p>
    </div>
  </section>

  <section class="posts">
    <div class="container">
      {
        posts.length === 0 ? (
          <div class="empty">
            <p>No posts yet — the first one is on its way.</p>
            <a href="/enquire" class="btn btn-primary">
              Get in touch <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        ) : (
          <div class="post-grid">
            {posts.map((post, i) => (
              <PostCard post={post} index={i % 3} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .posts {
    padding-block: var(--section-y);
  }

  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 620px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .post-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Empty state ── */
  .empty {
    text-align: center;
    max-width: 44ch;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg);
    background-color: var(--surface);
    border: 1px solid var(--brown-08);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .empty p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }
</style>
