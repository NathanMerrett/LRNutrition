---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PortableText from '../../components/PortableText.astro';
import { getPosts, getPost, formatDate, imageUrl } from '../../data/posts';

// One page per published post. Fetching the full post here (rather than in the
// component body) means each page is built with its own content.
export const getStaticPaths = (async () => {
  const posts = await getPosts();

  return Promise.all(
    posts.map(async (summary) => ({
      params: { slug: summary.slug },
      props: { post: (await getPost(summary.slug))! },
    })),
  );
}) satisfies GetStaticPaths;

const { post } = Astro.props;

const heroSrc = imageUrl(post.mainImage, { width: 1200, height: 630 });
---

<Layout title={`${post.title} | Laura Reynolds Nutrition`} description={post.summary}>
  <article class="post">
    <header class="post-header">
      <div class="container container-prose">
        <a href="/blog" class="back-link">
          <span class="arrow" aria-hidden="true">&larr;</span> Back to blog
        </a>
        <time datetime={post.publishedAt}>
          {formatDate(post.publishedAt)}
          {post.readingTime ? ` · ${post.readingTime} min read` : ''}
        </time>
        <h1>{post.title}</h1>
        {post.summary && <p class="summary">{post.summary}</p>}
      </div>
    </header>

    {
      heroSrc && (
        <div class="container container-prose hero-image">
          {/* Above the fold on this page, and almost always the LCP element —
              so it loads eagerly and at high priority rather than lazily. */}
          <img
            src={heroSrc}
            alt={post.mainImage?.alt ?? ''}
            width="1200"
            height="630"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }

    <div class="post-body container container-prose">
      <PortableText value={post.body} />
    </div>

    <div class="post-footer container container-prose">
      <a href="/enquire" class="cta-inline">
        <span>
          <strong>Want personalised advice?</strong>
          <span class="cta-sub">Tell me what you're working on and I'll get back to you.</span>
        </span>
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </article>
</Layout>

<style>
  /* ── Header ── */
  .post-header {
    background: linear-gradient(180deg, var(--blush) 0%, var(--blush-soft) 100%);
    padding-block: clamp(2rem, 6vw, 3.5rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brown);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: var(--space-lg);
    /* 44px tap target */
    padding-block: 0.6rem;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .back-link .arrow {
    transition: transform var(--dur-mid) var(--ease-out);
  }

  @media (hover: hover) {
    .back-link:hover {
      opacity: 1;
    }

    .back-link:hover .arrow {
      transform: translateX(-4px);
    }
  }

  time {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brown);
    margin-bottom: var(--space-sm);
  }

  h1 {
    font-size: var(--text-h3);
    color: var(--brown);
    line-height: 1.1;
  }

  .summary {
    margin-top: var(--space-md);
    color: var(--brown);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 58ch;
  }

  /* ── Hero image ──
   * Pulled up into the blush band so it straddles the join, which reads far
   * more designed than sitting squarely below it.
   */
  .hero-image {
    margin-top: clamp(-3rem, -5vw, -2rem);
    position: relative;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  /* ── Body ── */
  .post-body {
    padding-block: var(--space-2xl);
    line-height: 1.8;
    color: var(--text);
    font-size: 1.0625rem;
  }

  /* ── Footer CTA ── */
  .post-footer {
    padding-bottom: var(--section-y);
  }

  .cta-inline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    background: linear-gradient(135deg, var(--blush-tint) 0%, var(--blush-soft) 100%);
    border: 1px solid var(--blush);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    text-decoration: none;
    color: var(--brown);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--dur-mid) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out);
  }

  .cta-inline strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .cta-sub {
    display: block;
    font-size: 0.9rem;
    opacity: 0.75;
    line-height: 1.5;
  }

  .cta-inline .arrow {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--coral);
    color: var(--cream);
    font-size: 1.1rem;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  @media (hover: hover) {
    .cta-inline:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }

    .cta-inline:hover .arrow {
      transform: translateX(4px);
    }
  }
</style>
