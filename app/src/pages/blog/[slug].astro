---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PortableText from '../../components/PortableText.astro';
import { getPosts, getPost, formatDate, imageUrl } from '../../data/posts';

// One page per published post. Fetching the full post here (rather than in the
// component body) means each page is built with its own content.
export const getStaticPaths = (async () => {
  const posts = await getPosts();

  return Promise.all(
    posts.map(async (summary) => ({
      params: { slug: summary.slug },
      props: { post: (await getPost(summary.slug))! },
    })),
  );
}) satisfies GetStaticPaths;

const { post } = Astro.props;

const heroSrc = imageUrl(post.mainImage, { width: 1200, height: 630 });
---

<Layout title={`${post.title} | Laura Reynolds Nutrition`} description={post.summary}>
  <article class="post">
    <header class="post-header">
      <div class="container container-prose">
        <a href="/blog" class="back-link">
          <span class="arrow" aria-hidden="true">&larr;</span> Back to blog
        </a>
        <time datetime={post.publishedAt}>
          {formatDate(post.publishedAt)}
          {post.readingTime ? ` · ${post.readingTime} min read` : ''}
        </time>
        <h1>{post.title}</h1>
        {post.summary && <p class="summary">{post.summary}</p>}
      </div>
    </header>

    {
      heroSrc && (
        <div class="container container-prose hero-image">
          {/* Above the fold on this page, and almost always the LCP element —
              so it loads eagerly and at high priority rather than lazily. */}
          <img
            src={heroSrc}
            alt={post.mainImage?.alt ?? ''}
            width="1200"
            height="630"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }

    <div class="post-body container container-prose">
      <PortableText value={post.body} />
    </div>
  </article>
</Layout>

<style>
  /* ── Header ── */
  .post-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap-target);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-md);
  }

  .back-link .arrow {
    transition: transform var(--dur-mid) var(--ease-out);
  }

  @media (hover: hover) {
    .back-link:hover {
      color: var(--color-text);
    }

    .back-link:hover .arrow {
      transform: translateX(-4px);
    }
  }

  time {
    display: block;
    font-size: var(--text-small);
    line-height: var(--leading-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .summary {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
  }

  /* ── Hero image ──
   * Pulled up into the header band so it straddles the join, which reads far
   * more designed than sitting squarely below it.
   */
  .hero-image {
    margin-top: calc(-1 * var(--space-xl));
    position: relative;
  }

  .hero-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  /* ── Body ── */
  .post-body {
    padding-block: var(--space-2xl) var(--section-y);
  }
</style>
