---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Enquire | Laura Reynolds Nutrition" description="Get in touch to start your nutrition journey.">
  <section class="page-hero">
    <div class="container">
      <h1>Get in touch</h1>
      <p class="lede">Fill in the form below and I'll get back to you as soon as I can.</p>
    </div>
  </section>

  <section class="form-section section">
    <div class="container container-form">
      <!--
        The one and only enquiry form. It posts normally and redirects to
        /enquire/success — no JS, no fetch. Netlify detects it in the built
        HTML at deploy time, so it must stay server-rendered.
      -->
      <form
        name="enquiry"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/enquire/success"
        class="card reveal"
      >
        <!-- Netlify hidden field -->
        <input type="hidden" name="form-name" value="enquiry" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="field">
          <label for="name">Your name <span class="required">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" placeholder="Jane Smith" />
        </div>

        <div class="field">
          <label for="email">Email address <span class="required">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" placeholder="jane@example.com" />
        </div>

        <div class="field">
          <label for="phone">Phone number <span class="optional">(optional)</span></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+44 7700 000000" />
        </div>

        <div class="field">
          <label for="goal">What are you hoping to achieve? <span class="required">*</span></label>
          <textarea id="goal" name="goal" required rows="5" placeholder="Tell me a bit about your goals and what's brought you here..."></textarea>
        </div>

        <div class="field">
          <label for="how">How did you hear about me? <span class="optional">(optional)</span></label>
          <select id="how" name="how">
            <option value="">— Select —</option>
            <option value="instagram">Instagram</option>
            <option value="friend">Friend / family</option>
            <option value="google">Google search</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="submit-row">
          <button type="submit" class="btn btn-primary">Send enquiry</button>
          <p class="privacy-note">
            Your details are only used to reply to your enquiry.
            See the <a href="/privacy">privacy policy</a>.
          </p>
        </div>
      </form>
    </div>
  </section>
</Layout>

<style>
  .hidden {
    display: none;
  }

  /* ── Form ── */
  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: clamp(var(--space-lg), 4vw, var(--space-xl));
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  label {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-small);
    letter-spacing: var(--tracking-label);
  }

  .required {
    color: var(--color-primary);
  }

  .optional {
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }

  /* Borders use the muted text colour, not --color-border: an input's outline
     is how you find it, so it needs 3:1 against the card (this is 5.9:1). */
  input[type='text'],
  input[type='email'],
  input[type='tel'],
  textarea,
  select {
    width: 100%;
    min-height: var(--tap-target);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-text);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-color: var(--color-primary);
    border-radius: var(--radius-md);
  }

  /* :user-invalid only matches once someone has interacted with the field
     (or tried to submit), so the form doesn't turn red the moment it loads. */
  input:user-invalid,
  textarea:user-invalid {
    border-color: var(--color-error);
    box-shadow: inset 0 0 0 1px var(--color-error);
  }

  select {
    appearance: none;
    /* A chevron drawn from two gradients, so it uses the colour token instead
       of a hex value baked into an SVG data URI. */
    background-image:
      linear-gradient(45deg, transparent 50%, var(--color-text) 50%),
      linear-gradient(135deg, var(--color-text) 50%, transparent 50%);
    background-position:
      right calc(var(--space-md) + 5px) center,
      right var(--space-md) center;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    padding-right: var(--space-2xl);
  }

  textarea {
    resize: vertical;
    min-height: 140px;
  }

  .submit-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
    padding-top: var(--space-xs);
  }

  .privacy-note {
    font-size: var(--text-small);
    line-height: var(--leading-small);
    color: var(--color-text-muted);
  }

  /* The main action is full width on mobile. */
  @media (max-width: 480px) {
    .submit-row {
      align-items: stretch;
    }
  }
</style>
