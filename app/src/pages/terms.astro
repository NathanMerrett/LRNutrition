---
import Layout from '../layouts/Layout.astro';

// DRAFT SKELETON — headings are the usual ones for a UK coaching practice, but every
// [CONFIRM: …] placeholder must be filled in and the whole thing reviewed by Laura
// (and ideally her insurer or professional body) before this goes live.
// Do not publish as-is.

const lastUpdated = '[CONFIRM: date these terms were reviewed]';
---

<Layout
  title="Terms of Service | Laura Reynolds Nutrition"
  description="The terms that apply to this website and to nutrition coaching with Laura Reynolds."
>
  <section class="page-hero">
    <div class="container">
      <h1>Terms of service</h1>
      <p class="lede">The terms that apply to this site and to working with me.</p>
    </div>
  </section>

  <section class="prose-section">
    <div class="container container-prose prose">
      <p class="meta">Last updated: {lastUpdated}</p>

      <h2>About these terms</h2>
      <p>
        These terms cover your use of this website and, where relevant, nutrition
        coaching provided by Laura Reynolds, trading as Laura Reynolds Nutrition
        [CONFIRM: registered business name and address]. By using this site you accept
        them.
      </p>

      <h2>This site is not medical advice</h2>
      <p>
        Everything on this website, including blog posts, is general information. It is
        not medical advice and it is not a substitute for it. Nothing here is intended to
        diagnose, treat or cure any condition.
      </p>
      <p>
        If you have a medical condition, are pregnant, or are taking medication, speak to
        your GP or a registered dietitian before making significant changes to your diet.
        If you think you are experiencing a medical emergency, contact NHS 111 or 999.
      </p>

      <h2>Coaching services</h2>
      <p>
        Nutrition coaching is delivered on the terms agreed with you individually before
        we start, covering [CONFIRM: what is included, session format and length, and
        how many sessions]. Coaching is a collaborative process and depends on the
        information you give me. I cannot guarantee any particular outcome or result.
      </p>
      <p>
        You are responsible for telling me about any relevant medical conditions,
        allergies, intolerances or medications, and for keeping me up to date if those
        change.
      </p>

      <h2>Fees, payment and cancellation</h2>
      <p>
        Fees are as quoted to you before booking. [CONFIRM: when payment is due, accepted
        payment methods, notice period for cancelling or rescheduling a session, and
        whether late cancellations are charged.]
      </p>

      <h2>Qualifications and regulation</h2>
      <p>
        [CONFIRM: Laura's qualification and the professional body she is registered with —
        this currently appears as a placeholder on the About page too, and the two must
        match.]
      </p>

      <h2>Liability</h2>
      <p>
        I take reasonable care in providing this website and my coaching services.
        Nothing in these terms limits liability for death or personal injury caused by
        negligence, or for fraud. [CONFIRM: any further liability wording with Laura's
        insurer — do not invent this.]
      </p>

      <h2>Content on this site</h2>
      <p>
        The text, images and design on this website belong to Laura Reynolds Nutrition.
        You are welcome to link to it or quote from it with credit, but please do not
        reproduce it wholesale without asking.
      </p>

      <h2>Your privacy</h2>
      <p>
        How your personal information is handled is set out in the
        <a href="/privacy">privacy policy</a>.
      </p>

      <h2>Governing law</h2>
      <p>
        These terms are governed by the law of England and Wales. [CONFIRM: correct
        jurisdiction for Laura's location.]
      </p>

      <h2>Getting in touch</h2>
      <p>
        Questions about these terms can go to
        <a href="mailto:hello@lrnutrition.co.uk">hello@lrnutrition.co.uk</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ── Prose ── */
  .prose-section {
    padding-block: var(--section-y);
  }

  .prose h2 {
    font-size: 1.45rem;
    color: var(--brown);
    margin-top: 2.75rem;
    margin-bottom: var(--space-sm);
  }

  .prose h2:first-of-type {
    margin-top: 0;
  }

  .prose p {
    color: var(--text);
    line-height: 1.8;
    margin-bottom: var(--space-md);
  }

  .prose a {
    color: var(--coral-text);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  /* Draft placeholders are deliberately loud — they must not reach production
     unnoticed. Styled by content, so they disappear once the text is filled in. */
  .meta {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--text-muted);
    background-color: var(--blush-tint);
    border: 1px solid var(--blush);
    border-radius: var(--radius-pill);
    padding: 0.4rem 0.9rem;
    margin-bottom: 2.5rem;
  }
</style>
