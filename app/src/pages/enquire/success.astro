---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Enquiry Sent | Laura Reynolds Nutrition">
  <section class="success">
    <div class="container container-narrow">
      <div class="card enter">
        <div class="tick" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <h1>Thanks for getting in touch!</h1>
        <p>
          I've received your enquiry and will get back to you as soon as possible —
          usually within 1–2 working days.
        </p>
        <div class="actions">
          <a href="/" class="btn btn-primary">Back to home</a>
          <a href="/blog" class="btn btn-quiet">Read the blog</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .success {
    padding-block: var(--section-y);
  }

  .card {
    text-align: center;
    background-color: var(--surface);
    border: 1px solid var(--brown-08);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-md);
    padding: clamp(2rem, 6vw, 3.5rem) clamp(1.5rem, 5vw, 3rem);
  }

  .tick {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-lg);
    border-radius: 50%;
    background-color: var(--blush-soft);
    color: var(--coral-600);
  }

  .tick svg {
    width: 30px;
    height: 30px;
  }

  /* Draw the tick on, rather than just fading the circle in. */
  @media (prefers-reduced-motion: no-preference) {
    .tick svg polyline {
      stroke-dasharray: 32;
      stroke-dashoffset: 32;
      animation: draw-tick 0.5s var(--ease-out) 0.35s forwards;
    }
  }

  @keyframes draw-tick {
    to {
      stroke-dashoffset: 0;
    }
  }

  h1 {
    color: var(--brown);
    font-size: var(--text-h3);
    margin-bottom: var(--space-md);
  }

  p {
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 auto var(--space-xl);
    max-width: 44ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }

  .btn-quiet {
    background-color: var(--blush-tint);
    color: var(--brown);
  }

  @media (hover: hover) {
    .btn-quiet:hover {
      background-color: var(--blush-soft);
      transform: translateY(-2px);
    }
  }
</style>
