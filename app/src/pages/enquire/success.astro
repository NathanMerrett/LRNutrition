---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Enquiry Sent | Laura Reynolds Nutrition">
  <section class="success section">
    <div class="container container-narrow">
      <div class="success-card card enter">
        <div class="tick" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <h1>Thanks for getting in touch!</h1>
        <p>
          I've received your enquiry and will get back to you as soon as possible —
          usually within 1–2 working days.
        </p>
        <div class="actions">
          <a href="/" class="btn btn-primary">Back to home</a>
          <a href="/blog" class="btn btn-secondary">Read the blog</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .success-card {
    text-align: center;
    padding: clamp(var(--space-xl), 6vw, var(--space-2xl)) clamp(var(--space-lg), 5vw, var(--space-2xl));
  }

  /* The success colour on the blush accent is 3.8:1 — enough for an icon (3:1). */
  .tick {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-lg);
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-success);
  }

  .tick svg {
    width: 30px;
    height: 30px;
  }

  /* Draw the tick on, rather than just fading the circle in. */
  @media (prefers-reduced-motion: no-preference) {
    .tick svg polyline {
      stroke-dasharray: 32;
      stroke-dashoffset: 32;
      animation: draw-tick 0.5s var(--ease-out) 0.35s forwards;
    }
  }

  @keyframes draw-tick {
    to {
      stroke-dashoffset: 0;
    }
  }

  h1 {
    margin-bottom: var(--space-md);
  }

  p {
    margin: 0 auto var(--space-xl);
    max-width: 44ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }
</style>
