# Sanity project the website reads blog posts from.
# Both values are safe to expose — they identify a public dataset, they are not secrets.
# Copy this file to .env and fill in the values before running `npm run dev` or `npm run build`.
#
# Set the same two variables in Netlify (Site settings → Environment variables),
# or production builds will fail.
PUBLIC_SANITY_PROJECT_ID=kavbcyru
PUBLIC_SANITY_DATASET=production

# NOTE: if a Sanity API token is ever needed (it isn't today — the blog dataset is
# public and read at build time), it must NOT use the PUBLIC_ prefix. Anything
# prefixed PUBLIC_ is inlined into the client bundle and shipped to the browser.
